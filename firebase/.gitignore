functions/node_modules/
functions/lib/
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# Vue dashboard (firebase/web/) - source is committed, but its build output is not: `public/` is
# the Hosting root (firebase.json's hosting.public) and is fully regenerated by `npm run build`
# from firebase/web/ (see firebase/web/vite.config.js's build.outDir), same "commit source, not
# build output" convention as functions/lib/ above. Run `npm --prefix web install && npm --prefix
# web run build` before `firebase deploy --only hosting`.
web/node_modules/
public/*
!public/.gitkeep
