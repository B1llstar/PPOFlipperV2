rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Orders are created/updated only through Cloud Functions (which run with
    // admin privileges and bypass these rules entirely) so that quantity/price
    // guardrails and ownership are always enforced server-side. Signed-in users
    // may only read their own orders directly for live UI updates.
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow write: if false;
    }

    // Per-agent buy-fill history (GE Star V2's BuyLimitLedger, mirrored for cross-machine
    // visibility into rolling-4h buy-limit usage - see
    // plugins/ge-star-v2/.../GeStarFirestoreClient.java's recordBuyEvent). Written directly by
    // the plugin's service-account credentials (bypassing these rules the same way Cloud
    // Functions do), not through any client SDK - admin-only like tradableItems, no client
    // read/write path exists or is needed yet.
    match /buyLimits/{agentId}/events/{eventId} {
      allow read, write: if false;
    }

    // PPOFlipperStar's own per-account state (portfolio/cost-basis, buy-limit ledger, watchlist,
    // and an append-only trade-history log), keyed by the RuneScape account's stable
    // Client.getAccountHash() - see
    // plugins/ppo-flipper-star/.../sync/PPOFlipperStarFirestoreClient.java. Admin-only, same
    // pattern as buyLimits above: written directly by the plugin's service-account credentials
    // (bypassing these rules the same way Cloud Functions do), never through a client SDK - no
    // client read/write path exists or is needed, since this is Firestore-as-durable-cache for
    // the plugin's own local state, not anything a web UI reads yet.
    match /accounts/{accountHash}/portfolio/{itemId} {
      allow read, write: if false;
    }

    match /accounts/{accountHash}/buyLimitLedger/{itemId} {
      allow read, write: if false;
    }

    match /accounts/{accountHash}/watchlist/{itemId} {
      allow read, write: if false;
    }

    match /accounts/{accountHash}/tradeHistory/{tradeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
